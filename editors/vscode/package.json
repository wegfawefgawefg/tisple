{
  "name": "tisple",
  "displayName": "Tisple ][",
  "description": "Tisple ][ (.tsp): highlighting, errors, formatting and running on the built-in Apple IIe",
  "version": "0.2.0",
  "publisher": "tisple",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tisple",
        "aliases": [
          "Tisple ][",
          "tisple"
        ],
        "extensions": [
          ".tsp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tisple",
        "scopeName": "source.tisple",
        "path": "./syntaxes/tisple.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[tisple]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [
          100
        ],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "tisple.tisple"
      }
    },
    "commands": [
      {
        "command": "tisple.run",
        "title": "Tisple: Run on Apple II",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tisple.run",
          "when": "editorLangId == tisple",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tisple.run",
        "key": "f5",
        "when": "editorLangId == tisple"
      }
    ],
    "configuration": {
      "title": "Tisple",
      "properties": {
        "tisple.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tisple binary. Empty: build-debug/tisple in a folder above the file, else tisple on PATH."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wegfawefgawefg/tisple.git"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tisple",
    "onCommand:tisple.run"
  ]
}
