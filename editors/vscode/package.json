{
  "name": "tisple-syntax",
  "displayName": "Tisple ][",
  "description": "Syntax highlighting for Tisple ][ (.tsp), a typed Lisp for the Apple II",
  "version": "0.1.0",
  "publisher": "tisple",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tisple",
        "aliases": [
          "Tisple ][",
          "tisple"
        ],
        "extensions": [
          ".tsp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tisple",
        "scopeName": "source.tisple",
        "path": "./syntaxes/tisple.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[tisple]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [
          100
        ]
      }
    }
  }
}
