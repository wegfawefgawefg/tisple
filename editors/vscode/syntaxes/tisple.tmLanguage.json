{
  "$comment": "Generated by `tisple gen-editors editors` from src/reader/keywords.cpp; do not edit.",
  "name": "Tisple",
  "scopeName": "source.tisple",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#quote" },
    { "include": "#special" },
    { "include": "#type" },
    { "include": "#builtin" },
    { "include": "#constant" },
    { "include": "#pascal" },
    { "include": "#caps" },
    { "include": "#symbol" },
    { "include": "#paren" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.tisple",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.tisple",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.tisple", "match": "\\\\(?:x[0-9A-Fa-f]{2}|.)" }
      ]
    },
    "number": {
      "name": "constant.numeric.tisple",
      "match": "(?<![^\\s()'`,@])-?(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|[0-9]+)(?![^\\s()\";'`,])"
    },
    "keyword": {
      "name": "entity.other.attribute-name.keyword.tisple",
      "match": "(?<![^\\s()'`,@]):[^\\s()\";'`,]+"
    },
    "quote": {
      "name": "keyword.operator.quote.tisple",
      "match": ",@|['`,]"
    },
    "special": {
      "name": "keyword.control.tisple",
      "match": "(?<![^\\s()'`,@])(?:fn|let|const|struct|enum|if|do|while|for|match|return|break|continue|set|and|or|\\.|_|as|make|macro|import|quote|quasiquote|unquote|unquote_splicing)(?![^\\s()\";'`,])"
    },
    "type": {
      "name": "storage.type.tisple",
      "match": "(?<![^\\s()'`,@])(?:u8|i8|u16|i16|bool|void|ptr|array)(?![^\\s()\";'`,])"
    },
    "builtin": {
      "name": "support.function.builtin.tisple",
      "match": "(?<![^\\s()'`,@])(?:at|load|store|addr_of|io_read|io_write|jsr|wait_cycles|not|\\+|-|\\*|\\/|%|=|!=|<|<=|>|>=|&|\\||\\^|~|<<|>>)(?![^\\s()\";'`,])"
    },
    "constant": {
      "name": "constant.language.tisple",
      "match": "(?<![^\\s()'`,@])(?:true|false)(?![^\\s()\";'`,])"
    },
    "pascal": {
      "name": "entity.name.type.tisple",
      "match": "(?<![^\\s()'`,@])(?:[^\\s()\";'`,]*[./])?[A-Z][A-Za-z0-9]*[a-z][A-Za-z0-9]*#?(?![^\\s()\";'`,])"
    },
    "caps": {
      "name": "variable.other.constant.tisple",
      "match": "(?<![^\\s()'`,@])(?:[^\\s()\";'`,]*[./])?[A-Z][A-Z0-9_]*#?(?![^\\s()\";'`,])"
    },
    "symbol": {
      "match": "(?<![^\\s()'`,@])[^\\s()\";'`,]+"
    },
    "paren": {
      "name": "punctuation.section.parens.tisple",
      "match": "[()]"
    }
  }
}
