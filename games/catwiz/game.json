{
 "title": "Catwiz",
 "about": "A cat witch's dice roguelike for the Apple II. Turn the phone sideways to play by touch: tap a die, then who it is for; between fights, tap a card twice, or SKIP; tap her faces to read them. BAG shows her kit, ? the rules, LOG what happened. Upright, the buttons under the screen show only what can be pressed now.",
 "mockingboard": 5,
 "mouse": true,
 "look": "color",
 "pad": [
  {
   "size": "small",
   "keys": [
    {
     "label": "BAG",
     "key": "B",
     "look": "green",
     "when": "fight || reward",
     "live": "mine || reward"
    },
    {
     "label": "RULES",
     "key": "?",
     "look": "green",
     "when": "fight",
     "live": "mine"
    },
    {
     "label": "LOG",
     "key": "H",
     "look": "green",
     "when": "fight",
     "live": "mine"
    },
    {
     "label": "MEOW",
     "key": "M",
     "look": "orange",
     "when": "fight",
     "live": "mine"
    },
    {
     "label": "LET GO",
     "key": "ESC",
     "look": "green",
     "when": "fight || reward",
     "live": "(mine && (state.selected != 255 || state.looked != 255)) || (reward && picking)"
    }
   ]
  },
  {
   "size": "medium",
   "keys": [
    {
     "label": "<",
     "key": "LEFT",
     "look": "white",
     "when": "(fight && foes >= 2) || turns",
     "live": "mine || turns"
    },
    {
     "label": "RE-ROLL",
     "key": "R",
     "look": "white",
     "when": "fight",
     "live": "mine && state.rerolls > 0",
     "span": 2
    },
    {
     "label": "END TURN",
     "key": "E",
     "look": "white",
     "when": "fight",
     "live": "mine",
     "span": 2
    },
    {
     "label": "SKIP",
     "key": "S",
     "look": "white",
     "when": "reward && state.pick != state.Pick.door",
     "span": 2,
     "state_only": true
    },
    {
     "label": "CLOSE",
     "key": "ESC",
     "look": "white",
     "when": "page",
     "span": 2,
     "state_only": true
    },
    {
     "label": "START",
     "key": "RETURN",
     "look": "white",
     "when": "state.screen == state.Screen.title",
     "span": 2,
     "state_only": true
    },
    {
     "label": "GO ON",
     "key": "RETURN",
     "look": "white",
     "when": "over",
     "span": 2,
     "state_only": true
    },
    {
     "label": ">",
     "key": "RIGHT",
     "look": "white",
     "when": "(fight && foes >= 2) || turns",
     "live": "mine || turns"
    }
   ]
  },
  {
   "size": "big",
   "keys": [
    {
     "label": "ENEMY\n1",
     "key": "Z",
     "look": "violet",
     "when": "fight && state.actors.alive[1]",
     "live": "mine"
    },
    {
     "label": "ENEMY\n2",
     "key": "X",
     "look": "violet",
     "when": "fight && state.actors.alive[2]",
     "live": "mine"
    },
    {
     "label": "ENEMY\n3",
     "key": "C",
     "look": "violet",
     "when": "fight && state.actors.alive[3]",
     "live": "mine"
    }
   ]
  },
  {
   "size": "big",
   "keys": [
    {
     "label": "DIE\n1",
     "key": "1",
     "look": "card",
     "when": "fight && state.dice_n >= 1",
     "live": "mine && !state.played[0] && state.held[0] == 255"
    },
    {
     "label": "DIE\n2",
     "key": "2",
     "look": "card",
     "when": "fight && state.dice_n >= 2",
     "live": "mine && !state.played[1] && state.held[1] == 255"
    },
    {
     "label": "DIE\n3",
     "key": "3",
     "look": "card",
     "when": "fight && state.dice_n >= 3",
     "live": "mine && !state.played[2] && state.held[2] == 255"
    },
    {
     "label": "DIE\n4",
     "key": "4",
     "look": "card",
     "when": "fight && state.dice_n >= 4",
     "live": "mine && !state.played[3] && state.held[3] == 255"
    },
    {
     "label": "DIE\n5",
     "key": "5",
     "look": "card",
     "when": "fight && state.dice_n >= 5",
     "live": "mine && !state.played[4] && state.held[4] == 255"
    },
    {
     "label": "DIE\n6",
     "key": "6",
     "look": "card",
     "when": "fight && state.dice_n >= 6",
     "live": "mine && !state.played[5] && state.held[5] == 255"
    },
    {
     "label": "PICK\n1",
     "key": "1",
     "look": "card",
     "when": "reward && battle/reward.choices >= 1",
     "state_only": true
    },
    {
     "label": "PICK\n2",
     "key": "2",
     "look": "card",
     "when": "reward && battle/reward.choices >= 2",
     "state_only": true
    },
    {
     "label": "PICK\n3",
     "key": "3",
     "look": "card",
     "when": "reward && battle/reward.choices >= 3",
     "state_only": true
    },
    {
     "label": "PICK\n4",
     "key": "4",
     "look": "card",
     "when": "reward && battle/reward.choices >= 4",
     "state_only": true
    },
    {
     "label": "PICK\n5",
     "key": "5",
     "look": "card",
     "when": "reward && battle/reward.choices >= 5",
     "state_only": true
    },
    {
     "label": "PICK\n6",
     "key": "6",
     "look": "card",
     "when": "reward && battle/reward.choices >= 6",
     "state_only": true
    }
   ]
  }
 ],
 "names": {
  "battle": "state.screen == state.Screen.battle",
  "stage": "battle && state.page == state.Page.none",
  "fight": "stage && (state.phase == state.Phase.rolling || state.phase == state.Phase.player || state.phase == state.Phase.acting || state.phase == state.Phase.enemies)",
  "mine": "fight && state.phase != state.Phase.enemies && !(state.phase == state.Phase.acting && state.act_source == state.Source.move)",
  "reward": "stage && state.phase == state.Phase.reward",
  "page": "battle && state.page != state.Page.none && state.page != state.Page.won",
  "turns": "battle && (state.page == state.Page.bag || state.page == state.Page.rules)",
  "foes": "state.actors.alive[1] + state.actors.alive[2] + state.actors.alive[3]",
  "over": "battle && (state.page == state.Page.won || (state.page == state.Page.none && state.phase == state.Phase.lost && state.timer > 56))",
  "picking": "state.picked != 255 || state.pick == state.Pick.rest",
  "in_fight": "battle && (state.phase == state.Phase.rolling || state.phase == state.Phase.player || state.phase == state.Phase.acting || state.phase == state.Phase.enemies)",
  "fight_over": "battle && (state.phase == state.Phase.won || state.phase == state.Phase.lost)",
  "run_over": "battle && (state.page == state.Page.won || state.phase == state.Phase.lost)",
  "choosing": "battle && state.phase == state.Phase.reward && !battle/reward.fresh"
 },
 "telemetry": {
  "endpoint": "https://45.77.123.14/catwiz-telemetry",
  "fields": {
   "screen": "state.screen",
   "phase": "state.phase",
   "page": "state.page",
   "stage": "state.stage",
   "fight": "state.fight",
   "next_fight": "state.next_fight",
   "turn": "state.turn",
   "hp": "state.actors.hp[0]",
   "hp_kept": "state.hero_hp",
   "hp_most": "state.hero_max",
   "kinds": "state.actors.kind",
   "alive": "state.actors.alive",
   "hps": "state.actors.hp",
   "won": "state.phase == state.Phase.won",
   "run_won": "state.page == state.Page.won",
   "items": "state.items",
   "levels": "state.levels",
   "charms": "state.charms",
   "step": "state.pick",
   "picked": "state.picked",
   "choices": "battle/reward.choices",
   "offer": "battle/reward.choice",
   "offer_slot": "battle/reward.choice_slot"
  },
  "events": [
   {
    "name": "title",
    "when": "state.screen == state.Screen.title"
   },
   {
    "name": "run_start",
    "when": "battle"
   },
   {
    "name": "fight_start",
    "when": "in_fight",
    "fields": [
     "stage",
     "fight",
     "turn",
     "hp",
     "hp_most",
     "kinds",
     "alive",
     "hps"
    ]
   },
   {
    "name": "fight_end",
    "when": "fight_over",
    "fields": [
     "won",
     "stage",
     "fight",
     "turn",
     "hp",
     "hp_most",
     "kinds",
     "alive",
     "hps"
    ]
   },
   {
    "name": "pick",
    "change": [
     "choosing",
     "state.pick"
    ],
    "was": "choosing",
    "entry": [
     "hp_kept",
     "hp_most",
     "items",
     "levels",
     "charms"
    ],
    "before": [
     "step",
     "picked",
     "choices",
     "offer",
     "offer_slot"
    ],
    "fields": [
     "step",
     "stage",
     "fight",
     "next_fight",
     "hp_kept",
     "hp_most",
     "items",
     "levels",
     "charms"
    ]
   },
   {
    "name": "run_end",
    "when": "run_over",
    "fields": [
     "run_won",
     "stage",
     "fight",
     "turn",
     "hp",
     "hp_most",
     "kinds",
     "alive",
     "hps",
     "items",
     "levels",
     "charms"
    ]
   }
  ],
  "quit": [
   "screen",
   "phase",
   "page",
   "step",
   "stage",
   "fight",
   "turn",
   "hp"
  ]
 },
